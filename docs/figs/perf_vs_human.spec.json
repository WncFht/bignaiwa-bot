{
  "version": 1,
  "theme": "paper",
  "rc": { "font": "serif", "base": 7.8 },
  "size": { "slot": "full", "height": 1.7 },
  "colors": {
    "registries": {
      "grp": { "early": "vcoral", "long": "vteal" }
    }
  },
  "data": {
    "bot": [
      { "score": 2353,  "grp": "early", "row": "bot 12 局" },
      { "score": 2503,  "grp": "early", "row": "bot 12 局" },
      { "score": 4200,  "grp": "early", "row": "bot 12 局" },
      { "score": 4380,  "grp": "early", "row": "bot 12 局" },
      { "score": 7419,  "grp": "early", "row": "bot 12 局" },
      { "score": 14685, "grp": "long",  "row": "bot 12 局" },
      { "score": 14710, "grp": "long",  "row": "bot 12 局" },
      { "score": 18127, "grp": "long",  "row": "bot 12 局" },
      { "score": 19314, "grp": "long",  "row": "bot 12 局" },
      { "score": 24336, "grp": "long",  "row": "bot 12 局" },
      { "score": 31437, "grp": "long",  "row": "bot 12 局" },
      { "score": 33752, "grp": "long",  "row": "bot 12 局" }
    ]
  },
  "meta": {
    "ledger": "strip 图：每点 = E1 正式批一局终分（12 种子，3000 投截断上限）；grp=存活形态分色（early=早夭 vcoral、long=进复活循环 vteal）；背景带=真人榜滚动窗集中区 1200-4000（区间非逐条数据）；虚线 ref=真人榜第一 6856；点线 ref=bot 中位 14710",
    "caption": "数据源：E1 正式批 12 局（不截断口径）与真人榜滚动 20 条区间（2026-10-03 查询）"
  },
  "xaxis": {
    "label": "单局终分",
    "lim": [0, 36000],
    "ticks": [0, 5000, 10000, 15000, 20000, 25000, 30000, 35000]
  },
  "grid": "x-only",
  "series": [
    { "kind": "span", "dir": "v", "at": [1200, 4000], "color": "vgray", "alpha": 0.18 },
    { "kind": "ref", "dir": "v", "at": 6856, "color": "vink", "ls": "--", "lw": 0.8 },
    { "kind": "ref", "dir": "v", "at": 14710, "color": "vink", "ls": ":", "lw": 0.8 },
    {
      "kind": "scatter",
      "from": "bot",
      "by": "grp",
      "x": "score",
      "y": "row",
      "color": "grp",
      "s": 30,
      "alpha": 0.95
    },
    {
      "kind": "note",
      "at": [2600, 1.12],
      "units": ["data", "axes"],
      "text": "真人集中区 ~1.2k–4k",
      "props": { "ha": "center", "fontsize": 6.4 }
    },
    {
      "kind": "note",
      "at": [6856, 1.12],
      "units": ["data", "axes"],
      "text": "真人榜第一 6856",
      "props": { "ha": "left", "fontsize": 6.4 }
    },
    {
      "kind": "note",
      "at": [15050, 1.12],
      "units": ["data", "axes"],
      "text": "bot 中位 14710",
      "props": { "ha": "left", "fontsize": 6.4 }
    },
    {
      "kind": "note",
      "at": [4600, 0.72],
      "units": ["data", "axes"],
      "text": "早夭局 ×5",
      "props": { "ha": "center", "fontsize": 6.4 }
    },
    {
      "kind": "note",
      "at": [24500, 0.72],
      "units": ["data", "axes"],
      "text": "马拉松局 ×7（进复活循环）",
      "props": { "ha": "center", "fontsize": 6.4 }
    }
  ],
  "output": { "path": "perf_vs_human.png" }
}
